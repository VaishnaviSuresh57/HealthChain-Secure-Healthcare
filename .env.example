# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# --- MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=healthchain

# --- Security ---
# Leave SECRET_KEY empty to auto-generate and persist a random one (flask_secret.key).
# SECRET_KEY=
# Set to true when the site is served over HTTPS (enables Secure cookies + HSTS).
COOKIE_SECURE=false
# Auto-logout after this many minutes of inactivity.
SESSION_MINUTES=30
# Listen address. 127.0.0.1 = this computer only. Use 0.0.0.0 only behind a reverse proxy/firewall.
HOST=127.0.0.1

# --- Blockchain peers (optional) ---
# Shared secret that peer nodes must send. Use the SAME value on every node.
# Leave empty to disable receiving blocks from peers.
# PEER_TOKEN=
# ENABLE_DEV_ROUTES=false

# --- Ethereum / Ganache (optional) ---
GANACHE_URL=http://127.0.0.1:7545
